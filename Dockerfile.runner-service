FROM node:22-bookworm-slim
WORKDIR /app

# Local-development orchestrator only. The Docker socket is not an acceptable
# production multi-tenant boundary; production should replace this adapter.
RUN apt-get update \
  && apt-get install -y --no-install-recommends docker.io ca-certificates tar \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci
COPY . .

EXPOSE 3002
CMD ["npm", "run", "start:runner"]
