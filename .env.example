# Clerk — reuse the existing Clerk instance, but never commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# PostgreSQL
DATABASE_URL=postgresql://leetbattle:leetbattle@127.0.0.1:5432/leetbattle

# Internal service trust. The sentinels below are rejected at startup.
# Replace each with a distinct value generated by: openssl rand -base64 32
REALTIME_TICKET_SECRET=replace_with_at_least_32_random_bytes
RUNNER_INTERNAL_SECRET=replace_with_a_different_32_byte_secret
ROOM_INVITE_SECRET=replace_with_a_third_32_byte_secret
REALTIME_NOTIFY_SECRET=replace_with_a_fourth_32_byte_secret

# Browser-visible WebSocket origin and private runner URL.
NEXT_PUBLIC_REALTIME_URL=ws://127.0.0.1:3001
RUNNER_URL=http://127.0.0.1:3002
REALTIME_PORT=3001
RUNNER_PORT=3002

# Container images built from services/runner/images/*.
PYTHON_RUNNER_IMAGE=leetbattle-python-runner:3.13
JAVA_RUNNER_IMAGE=leetbattle-java-runner:21

# Public canonical web origin; used when validating return/invite URLs.
APP_ORIGIN=http://localhost:3000

# Opt-in real browser E2E. Keep disabled until the complete stack, Chromium,
# and two existing Clerk development/test users are ready.
RUN_REAL_E2E=0
E2E_BASE_URL=http://localhost:3000
E2E_CLERK_HOST_EMAIL=replace_with_existing_host@example.com
E2E_CLERK_GUEST_EMAIL=replace_with_existing_guest@example.com
