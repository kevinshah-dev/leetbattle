{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "leetbattle-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "ws.leetbattle.cenough.games",
      "custom_domain": true,
    },
  ],
  "vars": {
    "APP_ORIGIN": "https://leetbattle.cenough.games",
    // Deadline alarms can claim and recover AI/ML evaluations. Keep these
    // identical to the web Worker; the API key remains a Wrangler secret.
    "OPENAI_JUDGE_MODEL": "gpt-5.4-nano",
    "OPENAI_JUDGE_MAX_DAILY_REQUESTS": "1000",
    "OPENAI_JUDGE_MAX_DAILY_REQUESTS_PER_USER": "50",
    "OPENAI_JUDGE_MAX_DAILY_REQUESTS_PER_MATCH": "6",
  },
  "secrets": {
    "required": [
      "REALTIME_TICKET_SECRET",
      "ROOM_INVITE_SECRET",
      "REALTIME_NOTIFY_SECRET",
      "OPENAI_API_KEY",
    ],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_FRESH",
      // Replace this with a Hyperdrive configuration created using
      // `wrangler hyperdrive create ... --caching-disabled`.
      "id": "b635949fd4b44561989764b01b9a7ad7",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM_HUB",
        "class_name": "RoomHub",
      },
    ],
  },
  "exports": {
    "RoomHub": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "triggers": {
    // RoomHub alarms own active-room deadlines. This is a global recovery
    // backstop; the 00:17 UTC run also performs daily retention cleanup.
    "crons": ["17 */6 * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
}
